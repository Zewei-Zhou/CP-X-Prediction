*.csv
*.tsv
*.parquet
*.hdf5
*.h5
*.npy
*.npz
*.bin
*.zip
*.tar.gz
*.tgz
*.rar

# Ignore model checkpoints and saved models
*.ckpt
*.pt
*.pth
*.keras
*.onnx
model_weights/
saved_models/

